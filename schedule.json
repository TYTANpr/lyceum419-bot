10,,,,,,,,,,,,,,10,,,,,,,,,,,,,,10,,,,,,,,,,,,,,10,,,,,,,,,,,,,,10,,,,,,,,,,,,,,10,,,,,,,,,,,,,,10,,,,,,,,,,,,,
"""

DAYS_MAP = {
    "понедельник": 0, "вторник": 1, "среда": 2,
    "четверг": 3, "пятница": 4, "суббота": 5
}

ALL_CLASSES = [
    "5а","5б","5в","5г","6а","6б","6в","6г",
    "7а","7б","7в","8а","8б","8в","8г",
    "9а","9б","9в","9г","10а","10б","10в","11а","11б"
]

SHORT_NAMES = {
    "обществознание": "Общ-ние", "английский язык": "Ин. яз", "англ. язык": "Ин. яз",
    "анг/анг": "Ин. яз", "раз-ры о важном": "Разг. о важном", "разговоры о важном": "Разг. о важном",
    "вероятность и статистика": "Вер. и стат.", "вер. и статистика": "Вер. и стат.",
    "информатика": "Информ.", "инф/инф": "Информ.", "физкультура": "Физ-ра",
    "ф.культура": "Физ-ра", "ф.к/ф.к": "Физ-ра", "литература": "Лит-ра", "русский язык": "Рус. яз"
}

def clean(text):
    if not text: return ""
    t = text.strip().strip('"').strip("'")
    low = t.lower()
    for k, v in SHORT_NAMES.items():
        if k in low: return v
    return t

def run():
    schedule = {c: {str(d): {} for d in range(6)} for c in ALL_CLASSES}
    lines = RAW_CSV.strip().splitlines()
    
    current_day = None
    class_cols = {} # class_name: col_index

    for line in lines:
        parts = [p.strip() for p in line.split(",")]
        if not parts or not parts[0]:
            continue

        # День недели
        first_low = parts[0].lower()
        if first_low in DAYS_MAP:
            current_day = DAYS_MAP[first_low]
            continue

        # Строка с классами
        if "5а" in [p.lower() for p in parts] and "10а" in [p.lower() for p in parts]:
            class_cols = {}
            for idx, cell in enumerate(parts):
                c_low = cell.lower().strip()
                if c_low in ALL_CLASSES:
                    class_cols[c_low] = idx
            continue

        # Уроки (начинаются с цифры)
        if current_day is not None and parts[0].isdigit():
            lesson_num = parts[0]
            for c_name, col_idx in class_cols.items():
                if col_idx < len(parts):
                    subj = clean(parts[col_idx])
                    room = parts[col_idx + 1].strip() if col_idx + 1 < len(parts) else ""
                    if subj and not subj.isdigit():
                        schedule[c_name][str(current_day)][lesson_num] = [subj, room]

    with open("schedule.json", "w", encoding="utf-8") as f:
        json.dump(schedule, f, ensure_ascii=False, indent=2)

    print(f"✅ Сгенерировано расписание для всех {len(schedule)} классов!")

if __name__ == "__main__":
    run()
